# Shared ignore for both Vercel projects. Do not ignore merchant-web or web-shared —
# the portal project needs them. The API project excludes UI via functions.excludeFiles.
.venv
.env
.env.*
!.env.example
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/node_modules
**/.next
**/*.webp
examples/*/storefront-web
examples/retail
examples/entertainment
examples/telecom
examples/travel
shopping-agent/runtime-agent-sdk
merchant-agent/runtime-agent-sdk
plugins
docs
tests
scripts
.github
.claude-plugin
**/tests
**/test_*.py
