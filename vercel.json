{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "installCommand": "pip install -r requirements-vercel.txt",
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "memory": 2048,
      "excludeFiles": "{**/tests/**,**/*test*.py,examples/*/storefront-web/**,examples/*/merchant-web/**}"
    }
  }
}
